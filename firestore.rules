rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Membership is established only through an Admin SDK or the Firebase Console.
    // Browser code can never create or grant clinic membership for itself.
    function signedIn() {
      return request.auth != null;
    }

    function membership(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }

    function isMember(clinicId) {
      return signedIn() && membership(clinicId).data.status == 'active';
    }

    function hasRole(clinicId, allowedRoles) {
      return isMember(clinicId) && allowedRoles.hasAny([membership(clinicId).data.role]);
    }

    function canManageClinic(clinicId) {
      return hasRole(clinicId, ['owner', 'admin']);
    }

    function canWriteClinicalData(clinicId) {
      return hasRole(clinicId, ['owner', 'admin', 'clinician', 'assistant']);
    }

    // The legacy document remains in use while V2 is reviewed. It is deliberately
    // scoped to the same membership used for V2 and cannot be deleted by a client.
    match /soliMedicalApp/sharedClinicData {
      allow read: if isMember('shared-clinic-v1');
      allow create, update: if canWriteClinicalData('shared-clinic-v1');
      allow delete: if false;
    }

    match /clinics/{clinicId} {
      allow get: if isMember(clinicId);
      allow list, create, update, delete: if false;

      match /members/{memberUid} {
        allow get: if isMember(clinicId) && (request.auth.uid == memberUid || canManageClinic(clinicId));
        allow list: if canManageClinic(clinicId);
        allow create, update, delete: if false;
      }

      match /settings/general {
        allow read: if isMember(clinicId);
        allow create, update: if canManageClinic(clinicId);
        allow delete: if false;
      }

      match /patients/{patientId} {
        allow read: if isMember(clinicId);
        allow create, update: if canWriteClinicalData(clinicId);
        allow delete: if false;
      }

      match /visits/{visitId} {
        allow read: if isMember(clinicId);
        allow create, update: if canWriteClinicalData(clinicId);
        allow delete: if false;
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isMember(clinicId);
        allow create, update: if canWriteClinicalData(clinicId);
        allow delete: if false;
      }

      match /appointments/{appointmentId} {
        allow read: if isMember(clinicId);
        allow create, update: if canWriteClinicalData(clinicId);
        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if isMember(clinicId);
        allow create, update: if canWriteClinicalData(clinicId);
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isMember(clinicId);
        allow create, update: if canWriteClinicalData(clinicId);
        allow delete: if false;
      }

      match /catalogs/{catalogName} {
        allow read: if isMember(clinicId);
        allow create, update: if canManageClinic(clinicId);
        allow delete: if false;
      }

      match /auditLogs/{auditLogId} {
        allow read: if canManageClinic(clinicId);
        allow create: if canWriteClinicalData(clinicId);
        // Audit contents are immutable. The migration may only add mirror metadata.
        allow update: if canManageClinic(clinicId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mirroredAt', 'migratedAt', 'migrationId', 'schemaVersion']);
        allow delete: if false;
      }

      match /archiveManifests/{archiveId} {
        allow read: if canManageClinic(clinicId);
        allow create, update: if canManageClinic(clinicId);
        allow delete: if false;
      }

      match /migrationManifests/{migrationId} {
        allow read: if canManageClinic(clinicId);
        allow create, update: if canManageClinic(clinicId);
        allow delete: if false;
      }

      // No implicit permissions for future V2 collections.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // V3 keeps the same one-doctor-one-clinic boundary while presenting each
    // operational area as a top-level collection in the Firebase Console.
    // Every query must constrain clinicId, otherwise Firestore rejects it.
    function topLevelMember() {
      return resource.data.clinicId is string && isMember(resource.data.clinicId);
    }

    function topLevelClinicalWrite() {
      return request.resource.data.clinicId is string
        && canWriteClinicalData(request.resource.data.clinicId);
    }

    function topLevelManagerWrite() {
      return request.resource.data.clinicId is string
        && canManageClinic(request.resource.data.clinicId);
    }

    function keepsSameClinic() {
      return resource.data.clinicId == request.resource.data.clinicId;
    }

      match /patients/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /visits/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /prescriptions/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /appointments/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /invoices/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /expenses/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /waitingQueue/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelClinicalWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /settings/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelManagerWrite();
        allow update: if topLevelManagerWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /catalogs/{recordId} {
        allow read: if topLevelMember();
        allow create: if topLevelManagerWrite();
        allow update: if topLevelManagerWrite() && keepsSameClinic();
        allow delete: if false;
      }

      match /auditLogs/{recordId} {
        allow read: if topLevelMember() && canManageClinic(resource.data.clinicId);
        allow create: if topLevelClinicalWrite();
        allow update: if topLevelManagerWrite() && keepsSameClinic()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mirroredAt', 'migratedAt', 'migrationId', 'schemaVersion', 'topLevelMigratedAt', 'topLevelMigrationId']);
        allow delete: if false;
      }

      match /archiveManifests/{recordId} {
        allow read: if topLevelMember() && canManageClinic(resource.data.clinicId);
        allow create: if topLevelManagerWrite();
        allow update: if topLevelManagerWrite() && keepsSameClinic();
        allow delete: if false;
      }
  }
}
